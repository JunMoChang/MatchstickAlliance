                        <ui:Button name="btn-equip-1" text="装备" class="btn-equip"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="equip-item-2" class="equip-item">
                        <ui:VisualElement class="equip-item-icon-wrap">
                            <ui:VisualElement name="item-icon-2" class="equip-item-icon equip-item-icon--shield"/>
                            <ui:Label text="x1" class="item-count"/>
                            <ui:Label text="1" class="item-rarity"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="equip-item-stats">
                            <ui:Label text="防御: 59" class="item-stat"/>
                        </ui:VisualElement>
                        <ui:Button name="btn-equip-2" text="装备" class="btn-equip"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="equip-item-3" class="equip-item">
                        <ui:VisualElement class="equip-item-icon-wrap">
                            <ui:VisualElement name="item-icon-3" class="equip-item-icon equip-item-icon--gem">
                                <ui:Label text="+15" class="item-enhance-badge"/>
                            </ui:VisualElement>
                            <ui:Label text="x1" class="item-count"/>
                            <ui:Label text="1" class="item-rarity"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="equip-item-stats">
                            <ui:Label text="生命: 2232" class="item-stat"/>
                        </ui:VisualElement>
                        <ui:Button name="btn-equip-3" text="装备" class="btn-equip"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="equip-item-4" class="equip-item">
                        <ui:VisualElement class="equip-item-icon-wrap">
                            <ui:VisualElement name="item-icon-4" class="equip-item-icon equip-item-icon--gem2"/>
                            <ui:Label text="x1" class="item-count"/>
                            <ui:Label text="1" class="item-rarity"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="equip-item-stats">
                            <ui:Label text="生命: 1116" class="item-stat"/>
                        </ui:VisualElement>
                        <ui:Button name="btn-equip-4" text="装备" class="btn-equip"/>
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Button name="btn-close" text="✕" class="btn-close"/>
