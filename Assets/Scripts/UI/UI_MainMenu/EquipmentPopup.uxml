                            <ui:Label text="+47.98%" class="stat-bonus stat-bonus--blue"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="panel-right" class="panel panel-right">
                <ui:VisualElement name="tab-bar" class="tab-bar">
                    <ui:Button name="tab-equip" text="装备" class="tab-btn tab-btn--active"/>
                    <ui:Button name="tab-enhance" text="强化" class="tab-btn"/>
                    <ui:Button name="tab-skill" text="技能" class="tab-btn"/>
