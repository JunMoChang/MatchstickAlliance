                                <ui:VisualElement name="star-bar-1" class="star-bar">
                                    <ui:Label text="★x1" class="star-text"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="equip-slot-2" class="equip-slot">
                                <ui:VisualElement name="equip-icon-2" class="equip-icon"/>
                                <ui:Label name="enhance-2" text="+20" class="enhance-badge"/>
                                <ui:VisualElement name="star-bar-2" class="star-bar">
                                    <ui:Label text="★x1" class="star-text"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="equip-slot-3" class="equip-slot">
                                <ui:VisualElement name="equip-icon-3" class="equip-icon"/>
                                <ui:Label name="enhance-3" text="+20" class="enhance-badge"/>
                                <ui:VisualElement name="star-bar-3" class="star-bar">
                                    <ui:Label text="★x1" class="star-text"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="equip-slot-4" class="equip-slot">
                                <ui:VisualElement name="equip-icon-4" class="equip-icon"/>
                                <ui:Label name="enhance-4" text="+20" class="enhance-badge"/>
                                <ui:VisualElement name="star-bar-4" class="star-bar">
                                    <ui:Label text="★x1" class="star-text"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="equip-slot-5" class="equip-slot">
                                <ui:VisualElement name="equip-icon-5" class="equip-icon"/>
                                <ui:Label name="enhance-5" text="+25" class="enhance-badge"/>
                                <ui:VisualElement name="star-bar-5" class="star-bar">
                                    <ui:Label text="★x1" class="star-text"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="arrow-next" text="▶" class="arrow-next"/>
                        <ui:VisualElement name="page-dots" class="page-dots">
                            <ui:VisualElement class="dot dot--active"/>
                            <ui:VisualElement class="dot"/>
                            <ui:VisualElement class="dot"/>
                            <ui:VisualElement class="dot"/>
                            <ui:VisualElement class="dot"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="stats-panel" class="stats-panel">
                    <ui:VisualElement name="stats-row-1" class="stats-row">
                        <ui:Label name="stat-power" text="战力: 6447" class="stat-label"/>
                        <ui:Label name="stat-exp" text="经验: 195万/336万" class="stat-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="stats-row-2" class="stats-row">
                        <ui:VisualElement class="stats-cell">
                            <ui:Label text="生命: 35720" class="stat-label"/>
                            <ui:Label text="+101733" class="stat-bonus"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="stats-cell">
