<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:UI="UnityEngine.UIElements" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaLocation="UnityEngine.UIElements file:/E:/unityproject/火柴人联盟/UIElementsSchema/UnityEngine.UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/UI_MainMenu/EquipmentPopup.uss?fileID=7433441132597879392&amp;guid=383ebe31deed7304ba5e451fe76fb879&amp;type=3#EquipmentPopup"/>
    <ui:VisualElement name="equipment-popup" class="equipment-popup">
        <ui:VisualElement name="popup-root" class="popup-root">
            <ui:VisualElement name="panel-left" class="panel panel-left">
                <ui:VisualElement name="panel-title-bar" class="panel-title-bar">
                    <ui:Label name="title-label" text="装备" class="panel-title-text"/>
                </ui:VisualElement>
                <ui:VisualElement name="hero-body" class="hero-body">
                    <ui:VisualElement name="hero-portrait-area" class="hero-portrait-area">
                        <ui:Label name="hero-name" text="猴子 LV.52" class="hero-name-label"/>
                        <ui:VisualElement name="hero-sprite" class="hero-sprite"/>
                        <ui:Label name="star-display" text="★★★★★" class="star-display"/>
                        <ui:Button name="btn-upgrade-star" text="升星" class="btn-upgrade-star"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="equipment-bag" class="equipment-bag">
                        <ui:Label name="bag-label" text="一星装备背包" class="bag-label"/>
                        <ui:VisualElement name="equip-view" class="equip-view">
                            <ui:VisualElement name="equip-slot-0" class="equip-slot">
                                <ui:VisualElement name="equip-icon-0" class="equip-icon"/>
                                <ui:Label name="enhance-0" text="+25" class="enhance-badge"/>
                                <ui:VisualElement name="star-bar-0" class="star-bar">
                                    <ui:Label text="★x1" class="star-text"/>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement name="equip-slot-1" class="equip-slot">
                                <ui:VisualElement name="equip-icon-1" class="equip-icon"/>
