.roleSelect-popup {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    justify-content: center;
    align-items: center;
    background-color: rgb(0, 0, 0);
}

.bg-selected {
    background-image: url("project://database/Assets/UI/bg-popup_1.psd?fileID=2800000&guid=3496361ba5753e942960dcff1c362d26&type=3#bg-popup_1");
    position: relative;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    width: 920px;
    height: 400px;
}

.lab-hint {
    -unity-font-style: bold;
    color: rgb(72, 72, 72);
}

.bg-roleExhibition {
    height: 240px;
    flex-grow: 1;
    overflow: hidden;
}

.hero-scroll {
    flex-grow: 1;
    height: 220px;
    bottom: auto;
    position: absolute;
    top: auto;
    left: 0;
    right: 0;
}

.hero-track {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    padding: 0 20px;
    right: auto;
    left: auto;
    bottom: auto;
    top: auto;
    position: relative;
    width: auto;
}

.hero-card {
    width: 130px;
    height: 160px;
    flex-shrink: 0;
}

.scroll-bar {
    top: 200px;
    position: absolute;
    bottom: auto;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: space-between;
}

.bt-scrollLeft {
    background-image: url("project://database/Assets/UI/Switch.png?fileID=2800000&guid=bc819d0d0acc98f499857891414c10b8&type=3#Switch");
    rotate: 180deg;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.bt-scrollRight {
    background-image: url("project://database/Assets/UI/Switch.png?fileID=2800000&guid=bc819d0d0acc98f499857891414c10b8&type=3#Switch");
    rotate: 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.bt-panel {
    flex-direction: row;
    justify-content: center;
    position: absolute;
    bottom: 60px;
    top: auto;
    left: 460px;
    right: 460px;
}

.bt-cancel {
    width: 60px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    color: rgb(123, 33, 34);
    -unity-font-style: bold;
    margin-right: 30px;
}

.bt-ensure {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    width: 60px;
    color: rgb(38, 170, 84);
    -unity-font-style: bold;
    margin-right: 0;
    margin-left: 30px;
}

.lab-HintRoleNum {
    color: rgb(151, 0, 0);
    -unity-font-style: bold;
    position: absolute;
    bottom: 0;
    left: 0;
}
