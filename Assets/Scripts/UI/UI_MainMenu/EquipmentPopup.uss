:root {
    --color-bg-panel: rgba(30, 20, 15, 0.96);
    --color-bg-panel-dark: rgba(20, 13, 8, 0.98);
    --color-bg-stats: rgba(194, 194, 194, 183);
    --color-border: rgba(180, 140, 80, 0.6);
    --color-border-bright: rgba(220, 180, 80, 0.9);
    --color-title-bg: rgba(0, 0, 0, 0.95);
    --color-btn-red: rgb(200, 40, 40);
    --color-btn-red-hover: rgb(230, 60, 60);
    --color-btn-red-active: rgb(160, 20, 20);
    --color-text-white: rgb(255, 248, 235);
    --color-text-gold: rgb(255, 210, 80);
    --color-text-red: rgb(220, 60, 60);
    --color-text-green: rgb(80, 220, 100);
    --color-text-blue: rgb(80, 180, 255);
    --color-text-dark: rgb(40, 30, 20);
    --color-star: rgb(240, 60, 60);
    --color-slot-bg: rgba(27, 27, 27, 225);
    --color-slot-border: rgba(120, 90, 50, 0.7);
    --color-slot-active: rgba(255, 180, 0, 0.25);
    --color-tab-active: rgb(255, 248, 235);
    --color-tab-inactive: rgba(160, 140, 110, 0.8);
    --color-tab-border: rgba(200, 160, 80, 0.5);
    --radius-small: 4px;
    --radius-medium: 8px;
    --radius-large: 12px;
    --font-size-xs: 10px;
    --font-size-sm: 12px;
    --font-size-md: 14px;
    --font-size-lg: 16px;
    --font-size-xl: 18px;
    --font-size-xxl: 22px;
}

.equipment-popup {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
    flex-direction: row;
}

.popup-root {
    flex-direction: row;
    align-items: stretch;
    width: 760px;
    height: 560px;
}

.panel {
    background-color: var(--color-bg-panel);
    border-color: var(--color-border);
    border-width: 1px;
    flex-direction: column;
}

.panel-left {
    width: 400px;
    border-top-left-radius: var(--radius-large);
    border-bottom-left-radius: var(--radius-large);
    border-right-width: 0;
    padding-bottom: 0;
    overflow: hidden;
    background-color: rgba(242, 242, 242, 0.95);
}

.panel-title-bar {
    background-color: var(--color-title-bg);
    border-bottom-color: var(--color-border-bright);
    border-bottom-width: 1px;
    padding: 6px 0;
    align-items: center;
    justify-content: center;
}

.panel-title-text {
    color: var(--color-text-white);
    font-size: var(--font-size-lg);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hero-body {
    flex-direction: row;
    flex-grow: 1;
    padding: 6px 10px;
    align-items: center;
    justify-content: space-evenly;
    padding-bottom: 0;
    margin-bottom: 0;
}

.hero-portrait-area {
    flex-direction: column;
    width: 150px;
    height: 300px;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    padding-bottom: 0;
    padding-top: 0;
    padding-right: 0;
}

.hero-name-label {
    color: var(--color-text-dark);
    font-size: var(--font-size-lg);
    -unity-font-style: normal;
    padding-bottom: 10px;
}

.hero-sprite {
    width: 130px;
    height: 160px;
    background-color: rgba(255, 255, 255, 0.04);
    border-radius: var(--radius-medium);
}

.star-bar {
    position: absolute;
    bottom: 2px;
    left: 0;
    right: 0;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.4);
}

.star-text {
    color: var(--color-star);
    font-size: 9px;
    -unity-text-align: middle-center;
}

.equipment-bag {
    flex-direction: column;
    width: 170px;
    height: 300px;
    margin-left: 10px;
    align-content: flex-start;
    justify-content: flex-start;
    align-items: center;
}

.bag-label {
    color: var(--color-text-dark);
    font-size: var(--font-size-sm);
}

.equip-view {
    flex-direction: column;
    flex-wrap: wrap;
}

.equip-slot {
    width: 75px;
    height: 75px;
    margin: 3px;
    background-color: var(--color-slot-bg);
    border-color: var(--color-slot-border);
    border-width: 1px;
    border-radius: var(--radius-small);
    position: relative;
    align-items: center;
    justify-content: center;
    overflow: visible;
}

.equip-slot--active {
    background-color: var(--color-slot-active);
    border-color: rgba(255, 200, 50, 0.8);
    border-width: 1.5px;
}

.equip-icon {
    width: 48px;
    height: 48px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 3px;
}

.enhance-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    color: var(--color-text-gold);
    font-size: var(--font-size-xs);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 3px;
    padding: 0 2px;
}

.arrow-next {
    position: absolute;
    right: -16px;
    top: 50%;
    color: var(--color-text-gold);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    margin-right: 0;
    padding-right: 0;
}

.star-display {
    color: var(--color-star);
    font-size: 22px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    padding-bottom: 0;
    padding-top: 0;
}

.page-dots {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 4px;
}

.dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    background-color: rgba(180, 150, 100, 0.4);
    margin: 0 3px;
}

.dot--active {
    background-color: var(--color-text-gold);
    width: 9px;
    height: 9px;
}

.btn-upgrade-star {
    align-self: center;
    width: 100px;
    height: 20px;
    background-color: var(--color-btn-red);
    border-color: rgba(255, 100, 80, 0.6);
    border-width: 1px;
    border-radius: var(--radius-medium);
    color: var(--color-text-white);
    font-size: var(--font-size-lg);
    -unity-font-style: normal;
    margin-bottom: 6px;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.btn-upgrade-star:hover {
    background-color: var(--color-btn-red-hover);
}

.btn-upgrade-star:active {
    background-color: var(--color-btn-red-active);
    scale: 0.97 0.97;
}

.stats-panel {
    background-color: var(--color-bg-stats);
    padding: 14px 12px;
    margin: 0 0 0 0;
    flex-shrink: 0;
    padding-top: 20px;
    justify-content: space-between;
    align-items: stretch;
    align-self: auto;
    align-content: flex-start;
    margin-bottom: 20px;
}

.stats-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 3px;
    padding-bottom: 0;
}

.stats-cell {
    flex-direction: row;
    align-items: center;
}

.stat-label {
    color: var(--color-text-dark);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
}

.stat-bonus {
    color: var(--color-text-green);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    margin-left: 4px;
}

.stat-bonus--blue {
    color: var(--color-text-blue);
}

.panel-right {
    width: 360px;
    border-top-right-radius: var(--radius-large);
    border-bottom-right-radius: var(--radius-large);
    border-left-color: var(--color-border-bright);
    border-left-width: 1px;
    position: relative;
}

.btn-close {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 32px;
    height: 32px;
    background-color: var(--color-btn-red);
    border-color: rgba(255, 100, 80, 0.5);
    border-width: 1px;
    border-radius: 50%;
    color: var(--color-text-white);
    font-size: var(--font-size-lg);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.btn-close:hover {
    background-color: var(--color-btn-red-hover);
}

.btn-close:active {
    background-color: var(--color-btn-red-active);
}

.tab-bar {
    flex-direction: row;
    border-bottom-color: var(--color-tab-border);
    border-bottom-width: 1px;
    padding: 6px 8px 0 8px;
    padding-right: 46px;
}

.tab-btn {
    flex: 1;
    height: 34px;
    background-color: transparent;
    border-width: 0;
    color: var(--color-tab-inactive);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    border-radius: 0;
    transition-property: color, border-bottom-color;
    transition-duration: 0.15s;
}

.tab-btn:hover {
    color: var(--color-text-white);
}

.tab-btn--active {
    color: var(--color-tab-active);
    border-bottom-color: var(--color-text-gold);
    background-color: rgba(255, 210, 80, 0.08);
    border-top-left-radius: var(--radius-small);
    border-top-right-radius: var(--radius-small);
}

.equip-list {
    flex-grow: 1;
    padding: 4px 8px;
    --unity-scroll-view-content-container-padding: 4px;
    background-color: rgb(27, 27, 27);
}

.equip-list > .unity-scroll-view__content-container {
    padding: 4px 0;
}

.equip-list > #unity-scroll-bar-vertical {
    width: 5px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 3px;
}

.equip-list > #unity-scroll-bar-vertical > #unity-dragger {
    background-color: rgba(200, 160, 80, 0.5);
    border-radius: 3px;
}

.equip-item {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(150, 120, 70, 0.3);
    border-width: 1px;
    border-radius: var(--radius-small);
    margin-bottom: 5px;
    padding: 6px 8px;
    min-height: 72px;
    transition-property: background-color, border-color;
    transition-duration: 0.1s;
}

.equip-item:hover {
    background-color: rgba(255, 210, 80, 0.07);
    border-color: rgba(200, 160, 80, 0.5);
}

.equip-item-icon-wrap {
    width: 60px;
    height: 60px;
    position: relative;
    flex-shrink: 0;
    margin-right: 8px;
}

.equip-item-icon {
    width: 60px;
    height: 60px;
    background-color: rgba(80, 60, 30, 0.6);
    border-color: rgba(150, 120, 70, 0.5);
    border-width: 1px;
    border-radius: var(--radius-small);
}

.equip-item-icon--sword {
    background-color: rgba(60, 80, 120, 0.6);
}

.equip-item-icon--shield {
    background-color: rgba(80, 70, 40, 0.6);
}

.equip-item-icon--gem {
    background-color: rgba(120, 30, 40, 0.6);
}

.equip-item-icon--gem2 {
    background-color: rgba(100, 30, 35, 0.6);
}

.item-count {
    position: absolute;
    bottom: 2px;
    right: 2px;
    color: var(--color-text-white);
    font-size: var(--font-size-xs);
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 3px;
    padding: 0 2px;
}

.item-rarity {
    position: absolute;
    top: 2px;
    left: 2px;
    color: var(--color-text-gold);
    font-size: var(--font-size-xs);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 3px;
    padding: 0 2px;
}

.item-enhance-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    color: var(--color-text-gold);
    font-size: var(--font-size-xs);
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 3px;
    padding: 0 2px;
}

.equip-item-stats {
    flex: 1;
    flex-direction: column;
    padding: 0 4px;
}

.item-stat {
    color: var(--color-text-white);
    font-size: var(--font-size-sm);
    margin-bottom: 2px;
}

.item-stat--crit {
    color: var(--color-text-gold);
}

.btn-equip {
    width: 62px;
    height: 36px;
    background-color: var(--color-btn-red);
    border-color: rgba(255, 100, 80, 0.5);
    border-width: 1px;
    border-radius: var(--radius-medium);
    color: var(--color-text-white);
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
    cursor: link;
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.btn-equip:hover {
    background-color: var(--color-btn-red-hover);
}

.btn-equip:active {
    background-color: var(--color-btn-red-active);
    scale: 0.95 0.95;
}
