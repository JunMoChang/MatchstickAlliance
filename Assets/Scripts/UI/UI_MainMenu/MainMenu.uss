.root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-image: none;
}

.background {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/UI/UI_BackGround/MainMenu/MainMenu.png?fileID=2800000&guid=39d70ee52042d684e8b134de6ef3c597&type=3#MainMenu");
}

.top-bar {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    height: 56px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    background-color: rgba(0, 0, 0, 0);
}

.game-title {
    font-size: 20px;
    color: rgb(232, 213, 163);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.res-row {
    flex-direction: row;
    align-items: center;
}

.res-item {
    flex-direction: row;
    align-items: center;
    border-radius: 0;
    border-width: 0;
    border-color: rgba(255, 255, 255, 0);
    background-color: rgba(255, 255, 255, 0);
    padding: 4px 10px;
    margin-left: 8px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.res-item > Label {
    font-size: 12px;
    color: rgb(200, 212, 232);
    margin-left: 4px;
    opacity: 1;
    display: flex;
    visibility: visible;
    overflow: visible;
}

.res-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0);
}

.res-gold .res-dot {
    background-color: rgba(220, 180, 60, 0.9);
    background-image: url("project://database/Assets/UI/UI_Levels/%E9%87%91%E5%B8%81.png?fileID=2800000&guid=145104381b29315489cab0d4847b588a&type=3#金币");
    width: 35px;
    height: 35px;
}

.res-gem .res-dot {
    background-color: rgba(100, 160, 255, 0.9);
    background-image: url("project://database/Assets/UI/UI_Levels/%E9%92%BB%E7%9F%B3.png?fileID=2800000&guid=2a8696960b6fb6e4389d52bd5ec27f84&type=3#钻石");
    width: 35px;
    height: 35px;
}

.res-hp .res-dot {
    background-color: rgba(255, 100, 100, 0.9);
    width: 35px;
    height: 35px;
}

.section-label {
    position: absolute;
    top: 64px;
    left: 20px;
    font-size: 11px;
    color: rgba(180, 200, 230, 0.6);
    letter-spacing: 2px;
}

.carousel-wrapper {
    position: absolute;
    top: 85px;
    left: 0;
    right: 0;
    height: 340px;
}

.card-scroll {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.card-track {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    width: 100%;
    height: 100%;
}

.game-card {
    width: 220px;
    height: 300px;
    overflow: hidden;
    margin-right: 280px;
    flex-shrink: 0;
    position: relative;
    transition-property: translate, scale;
    transition-duration: 0.25s;
    justify-content: flex-start;
    flex-direction: row;
    right: auto;
    left: auto;
    flex-wrap: nowrap;
    align-items: auto;
    transform-origin: center;
}

.game-card:hover {
    scale: 1.04;
}

.game-card--pressing {
    scale: 0.97;
}

.game-card--active {
    translate: 0 -10px 0;
}

.card-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
    width: auto;
}

.card-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.45);
}

.card-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 16px;
    flex-direction: column;
}

.card-type {
    font-size: 10px;
    color: rgba(180, 210, 255, 0.7);
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.card-btn {
    width: 100px;
    height: 28px;
    border-radius: 14px;
    border-width: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    flex-direction: column;
}

.nav-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 96px;
    flex-direction: row;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 0 20px 16px;
    background-color: rgba(0, 0, 0, 0);
}

.nav-btn {
    flex-direction: column;
    align-items: center;
    margin-left: 10px;
    transition-property: translate;
    transition-duration: 0.2s;
}

.nav-btn:hover {
    translate: 0 -3px 0;
}

.nav-btn:active {
    scale: 0.92;
}

.nav-icon {
    width: 52px;
    height: 52px;
    border-radius: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 4px;
    background-image: none;
}

.nav-label {
    font-size: 10px;
    color: rgba(180, 200, 230, 0.7);
}

.nav-badge {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 16px;
    height: 16px;
    border-radius: 8px;
    background-color: rgb(255, 68, 68);
    border-width: 1.5px;
    border-color: rgb(8, 12, 26);
    color: white;
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
