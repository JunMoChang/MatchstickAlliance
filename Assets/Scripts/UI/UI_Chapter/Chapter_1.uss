#root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
}

#sky {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/UI/UI_BackGround/Chapter/Chapter_1/%E8%83%8C%E6%99%AF6.png?fileID=2800000&guid=0464410b16db00245a77e80e5dcb27f5&type=3#背景6");
}

#mountain-far {
    position: absolute;
    bottom: 0%;
    left: 30%;
    width: 64%;
    height: 48%;
    -unity-background-scale-mode: stretch-to-fill;
    opacity: 0.85;
    top: 30%;
    right: 0%;
    background-image: url("project://database/Assets/UI/UI_BackGround/Chapter/Chapter_1/%E8%83%8C%E6%99%AF_%E5%B1%B1.png?fileID=2800000&guid=ef9c508ef63768b4fb069a10050504d1&type=3#背景_山");
}

#mountain-near {
    position: absolute;
    bottom: 10%;
    left: 0;
    width: 47%;
    height: 20%;
    -unity-background-scale-mode: stretch-to-fill;
    background-image: url("project://database/Assets/UI/UI_BackGround/Chapter/Chapter_1/%E8%83%8C%E6%99%AF17.png?fileID=2800000&guid=f0975640072f7d04caea6cad3e1594ff&type=3#背景17");
    top: 70%;
    right: 46%;
}

#clouds {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

#clouds > VisualElement {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}

#cloud-a {
    top: 8%;
    left: 5%;
    width: 280px;
    height: 120px;
    opacity: 0.9;
}

#cloud-b {
    top: 15%;
    left: 40%;
    width: 200px;
    height: 90px;
    opacity: 0.7;
}

#cloud-c {
    top: 5%;
    left: 70%;
    width: 240px;
    height: 100px;
    opacity: 0.8;
}

#foreground {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 25%;
    -unity-background-scale-mode: stretch-to-fill;
}

#ground {
    background-image: url("project://database/Assets/UI/UI_BackGround/Chapter/Chapter_1/%E5%9C%B0%E9%9D%A21.png?fileID=2800000&guid=ee1addfbe75773446ad3b0256e466f8c&type=3#地面1");
    background-color: rgb(0, 0, 0);
    bottom: 0;
    left: 0;
    right: 0;
    top: 90%;
    width: 100%;
    height: 10%;
}
